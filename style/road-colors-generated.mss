/* Dark mode colors - high contrast against dark background */
@motorway-casing: #8a3a5a;
@trunk-casing: #8a5a3a;
@primary-casing: #7a6a2a;
@secondary-casing: #5a6a3a;
@motorway-fill: #b85070;
@trunk-fill: #c07050;
@primary-fill: #c0a050;
@secondary-fill: #90a060;
@motorway-low-zoom: #a04060;
@trunk-low-zoom: #a06040;
@primary-low-zoom: #a08030;
@secondary-low-zoom: #708050;
@motorway-low-zoom-casing: #7a3050;
@trunk-low-zoom-casing: #8a5030;
@primary-low-zoom-casing: #8a6a20;
@secondary-low-zoom-casing: #506030;
@motorway-shield: #e0b0c0;
@trunk-shield: #e0c0a0;
@primary-shield: #e0d0a0;
@secondary-shield: #c0d0a0;
