/* Dark mode colors - improved visibility for driver navigation */
@motorway-casing: #9a4a6a;
@trunk-casing: #9a6a4a;
@primary-casing: #8a7a3a;
@secondary-casing: #6a7a4a;
@motorway-fill: #c86080;
@trunk-fill: #d08060;
@primary-fill: #d0b060;
@secondary-fill: #a0b070;
@motorway-low-zoom: #b05070;
@trunk-low-zoom: #b07050;
@primary-low-zoom: #b09040;
@secondary-low-zoom: #809060;
@motorway-low-zoom-casing: #8a4060;
@trunk-low-zoom-casing: #9a6040;
@primary-low-zoom-casing: #9a7a30;
@secondary-low-zoom-casing: #607040;
@motorway-shield: #f0c0d0;
@trunk-shield: #f0d0b0;
